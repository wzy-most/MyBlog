---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts, sitePath } from '../utils/posts';

const posts = await getPublishedPosts();
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const latestPosts = posts.slice(0, 6);
---

<BaseLayout>
	<section class="peach-hero">
		<div class="hero-copy">
			<p class="eyebrow glow-kicker">Personal Blog</p>
			<h1 class="page-title peach-title ripple-text" data-ripple-text>
				莫等闲，白了少年头，空悲切。
			</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
			<div class="hero-actions">
				<a class="motion-button particle-button" href={sitePath('/blog/')}>进入文章</a>
			</div>
		</div>
	</section>

	{
		featuredPosts.length > 0 && (
			<section class="section">
				<p class="eyebrow">精选文章</p>
				<div class="post-grid">
					{featuredPosts.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="section-heading">
			<div>
				<p class="eyebrow">最新文章</p>
				<h2>最近更新</h2>
			</div>
			<a class="text-action particle-button" href={sitePath('/blog/')}>查看全部</a>
		</div>
		<div class="post-list">
			{latestPosts.map((post) => <PostCard post={post} headingLevel={3} />)}
		</div>
	</section>
</BaseLayout>

<style>
	.peach-hero {
		position: relative;
		min-height: 360px;
		padding: 44px;
		overflow: hidden;
		border: 1px solid rgba(83, 119, 192, 0.3);
		border-radius: 20px;
		background:
			radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.15), transparent 25%),
			radial-gradient(circle at 88% 18%, rgba(68, 96, 172, 0.26), transparent 30%),
			linear-gradient(135deg, #142440 0%, #1a3057 54%, #213e6f 100%);
		box-shadow: 0 22px 54px rgba(10, 20, 42, 0.34);
	}

	.peach-hero::before {
		position: absolute;
		inset: 0;
		content: '';
		background:
			linear-gradient(120deg, transparent 0 35%, rgba(255, 255, 255, 0.36), transparent 66% 100%),
			linear-gradient(rgba(255, 255, 255, 0.24) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, transparent 1px);
		background-size: auto, 34px 34px, 34px 34px;
		animation: hero-sheen 5.2s linear infinite;
		pointer-events: none;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		max-width: 860px;
	}

	.glow-kicker {
		color: #93b3f7;
		text-shadow: 0 0 14px rgba(120, 165, 255, 0.28);
	}

	.peach-title {
		max-width: 820px;
		color: #111;
		font-family:
			"PingFang SC",
			"Hiragino Sans GB",
			"Microsoft YaHei",
			"Source Han Sans SC",
			"Noto Sans SC",
			"Arial Rounded MT Bold",
			sans-serif;
		font-weight: 800;
		letter-spacing: 0.02em;
		-webkit-text-stroke: 0.6px rgba(255, 255, 255, 0.45);
		background-image: linear-gradient(
			112deg,
			#060606 0%,
			#131722 23%,
			#0c1a16 46%,
			#1a1120 66%,
			#1b1010 84%,
			#040404 100%
		);
		background-size: 200% 200%;
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow:
			0 1px 0 rgba(255, 255, 255, 0.2),
			0 3px 6px rgba(0, 0, 0, 0.25),
			0 0 14px rgba(65, 90, 168, 0.2),
			0 0 18px rgba(40, 118, 84, 0.16),
			0 0 24px rgba(115, 60, 140, 0.16),
			0 0 30px rgba(140, 64, 64, 0.14);
		animation:
			peach-neon 4.2s ease-in-out infinite,
			chroma-black 8s ease-in-out infinite;
		cursor: pointer;
		user-select: none;
	}

	.peach-hero .lead {
		color: #cfdbf7;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.motion-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 20px;
		overflow: visible;
		border: 0;
		border-radius: 16px;
		background: linear-gradient(135deg, #4e72be, #5e87da 54%, #7ba2ee);
		box-shadow:
			0 9px 0 #35599f,
			0 18px 26px rgba(10, 22, 46, 0.36);
		color: #edf3ff;
		font: inherit;
		font-weight: 800;
		text-decoration: none;
		transform: translateY(0);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			filter 180ms ease;
	}

	.motion-button:hover {
		box-shadow:
			0 4px 0 #35599f,
			0 10px 18px rgba(10, 22, 46, 0.3);
		color: #edf3ff;
		filter: saturate(1.02);
		transform: translateY(6px) scale(0.99);
	}

	.motion-button:active,
	.motion-button.is-pressed {
		box-shadow:
			0 2px 0 #35599f,
			0 6px 12px rgba(10, 22, 46, 0.26);
		transform: translateY(8px) scale(0.97);
	}

	.ghost-button {
		border: 1px solid rgba(139, 174, 248, 0.44);
		background: rgba(24, 42, 79, 0.64);
		box-shadow:
			0 9px 0 rgba(39, 63, 116, 0.8),
			0 18px 26px rgba(10, 22, 46, 0.26);
		color: #d8e6ff;
		backdrop-filter: blur(12px);
	}

	.ghost-button:hover {
		color: #edf3ff;
	}

	.text-action {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 0 12px;
		overflow: visible;
		border-radius: 999px;
		background: rgba(80, 114, 184, 0.28);
		color: #eaf1ff;
		text-decoration: none;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 18px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.8rem;
		line-height: 1.2;
	}

	@media (max-width: 620px) {
		.peach-hero {
			min-height: auto;
			padding: 28px 18px;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@keyframes hero-sheen {
		from {
			transform: translateX(-80%);
		}

		to {
			transform: translateX(80%);
		}
	}

	@keyframes peach-neon {
		0%,
		100% {
			text-shadow:
				0 1px 0 rgba(255, 255, 255, 0.2),
				0 3px 6px rgba(0, 0, 0, 0.25),
				0 0 14px rgba(65, 90, 168, 0.2),
				0 0 18px rgba(40, 118, 84, 0.16),
				0 0 24px rgba(115, 60, 140, 0.16),
				0 0 30px rgba(140, 64, 64, 0.14);
		}

		50% {
			text-shadow:
				0 1px 0 rgba(255, 255, 255, 0.22),
				0 4px 8px rgba(0, 0, 0, 0.3),
				0 0 16px rgba(82, 106, 184, 0.24),
				0 0 22px rgba(51, 140, 102, 0.2),
				0 0 28px rgba(132, 76, 162, 0.2),
				0 0 34px rgba(162, 78, 78, 0.18);
		}
	}

	@keyframes chroma-black {
		0%,
		100% {
			background-position: 0% 50%;
		}

		50% {
			background-position: 100% 50%;
		}
	}
</style>

<script>
	const rippleTargets = document.querySelectorAll<HTMLElement>('[data-ripple-text]');

	for (const target of rippleTargets) {
		target.addEventListener('pointerdown', (event) => {
			const rect = target.getBoundingClientRect();
			const ring = document.createElement('span');
			ring.className = 'text-ripple';
			ring.style.left = `${event.clientX - rect.left}px`;
			ring.style.top = `${event.clientY - rect.top}px`;
			target.appendChild(ring);
			ring.addEventListener('animationend', () => ring.remove(), { once: true });
		});
	}

	const functionalControls = document.querySelectorAll<HTMLElement>(
		'.particle-button, .site-header a, .tag, button, [role="button"]',
	);

	for (const control of functionalControls) {
		control.addEventListener('pointerdown', (event) => {
			const rect = control.getBoundingClientRect();
			const originX = event.clientX - rect.left;
			const originY = event.clientY - rect.top;
			control.classList.add('is-pressed');

			for (let index = 0; index < 18; index += 1) {
				const particle = document.createElement('span');
				const angle = (Math.PI * 2 * index) / 18;
				const distance = 24 + Math.random() * 38;
				particle.className = 'button-particle';
				particle.style.left = `${originX}px`;
				particle.style.top = `${originY}px`;
				particle.style.setProperty('--x', `${Math.cos(angle) * distance}px`);
				particle.style.setProperty('--y', `${Math.sin(angle) * distance}px`);
				control.appendChild(particle);
				particle.addEventListener('animationend', () => particle.remove(), { once: true });
			}
		});

		control.addEventListener('pointerup', () => control.classList.remove('is-pressed'));
		control.addEventListener('pointerleave', () => control.classList.remove('is-pressed'));
	}

</script>

