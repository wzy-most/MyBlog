---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts, sitePath } from '../utils/posts';

const posts = await getPublishedPosts();
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const latestPosts = posts.slice(0, 6);
---

<BaseLayout>
	<section class="cyber-hero">
		<div class="hero-copy">
			<p class="eyebrow neon-kicker">Personal Blog</p>
			<h1 class="page-title neon-title ripple-text" data-ripple-text>
				写代码，也记录代码之外的事。
			</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
			<div class="hero-actions">
				<a class="motion-button particle-button" href={sitePath('/blog/')}>进入文章</a>
				<button class="motion-button ghost-button particle-button" type="button">点击触发粒子</button>
			</div>
		</div>
		<div class="loader-panel" aria-label="Canvas 多边形 loading 动画">
			<canvas id="polygon-loader" width="320" height="320"></canvas>
			<div class="loader-caption">
				<span>Loading Lab</span>
				<strong>Canvas Polygon</strong>
			</div>
		</div>
	</section>

	{
		featuredPosts.length > 0 && (
			<section class="section">
				<p class="eyebrow">精选文章</p>
				<div class="post-grid">
					{featuredPosts.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="section-heading">
			<div>
				<p class="eyebrow">最新文章</p>
				<h2>最近更新</h2>
			</div>
			<a href={sitePath('/blog/')}>查看全部</a>
		</div>
		<div class="post-list">
			{latestPosts.map((post) => <PostCard post={post} headingLevel={3} />)}
		</div>
	</section>
</BaseLayout>

<style>
	.cyber-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		align-items: center;
		gap: 36px;
		min-height: 560px;
		padding: 44px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background:
			linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
			linear-gradient(135deg, #16181f 0%, #0f2624 48%, #2c231c 100%);
		background-size: 34px 34px, 34px 34px, auto;
		box-shadow: 0 28px 70px rgba(20, 24, 30, 0.24);
	}

	.cyber-hero::before {
		position: absolute;
		inset: 0;
		content: '';
		background: linear-gradient(120deg, transparent 0 36%, rgba(107, 255, 229, 0.16), transparent 64% 100%);
		animation: hero-scan 5.4s linear infinite;
		pointer-events: none;
	}

	.hero-copy,
	.loader-panel {
		position: relative;
		z-index: 1;
	}

	.neon-kicker {
		color: #77ffe6;
		text-shadow: 0 0 14px rgba(119, 255, 230, 0.72);
	}

	.neon-title {
		max-width: 820px;
		color: #fffdf7;
		text-shadow:
			0 0 4px rgba(255, 255, 255, 0.95),
			0 0 14px rgba(119, 255, 230, 0.8),
			0 0 30px rgba(255, 91, 123, 0.48),
			0 0 54px rgba(255, 204, 92, 0.3);
		animation: neon-flow 4.6s ease-in-out infinite;
		cursor: pointer;
		user-select: none;
	}

	.cyber-hero .lead {
		color: rgba(255, 253, 247, 0.76);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.motion-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 20px;
		overflow: visible;
		border: 0;
		border-radius: 8px;
		background: linear-gradient(135deg, #77ffe6, #ffc857 54%, #ff5b7b);
		box-shadow:
			0 9px 0 #7e3635,
			0 18px 28px rgba(0, 0, 0, 0.28);
		color: #15171d;
		font: inherit;
		font-weight: 800;
		text-decoration: none;
		transform: translateY(0);
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			filter 140ms ease;
	}

	.motion-button:hover {
		color: #15171d;
		filter: saturate(1.18);
	}

	.motion-button:active,
	.motion-button.is-pressed {
		box-shadow:
			0 3px 0 #7e3635,
			0 8px 16px rgba(0, 0, 0, 0.26);
		transform: translateY(6px) scale(0.98);
	}

	.ghost-button {
		border: 1px solid rgba(119, 255, 230, 0.5);
		background: rgba(255, 255, 255, 0.08);
		box-shadow:
			0 9px 0 rgba(119, 255, 230, 0.18),
			0 18px 28px rgba(0, 0, 0, 0.22);
		color: #fffdf7;
		backdrop-filter: blur(12px);
	}

	.ghost-button:hover {
		color: #fffdf7;
	}

	.loader-panel {
		display: grid;
		place-items: center;
		gap: 10px;
		padding: 18px;
		border: 1px solid rgba(119, 255, 230, 0.28);
		border-radius: 8px;
		background: rgba(8, 14, 18, 0.42);
		box-shadow: inset 0 0 34px rgba(119, 255, 230, 0.08);
	}

	#polygon-loader {
		width: 100%;
		max-width: 300px;
		aspect-ratio: 1;
	}

	.loader-caption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		width: 100%;
		color: rgba(255, 253, 247, 0.72);
		font-size: 0.86rem;
	}

	.loader-caption strong {
		color: #ffc857;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 18px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.8rem;
		line-height: 1.2;
	}

	@media (max-width: 620px) {
		.cyber-hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding: 28px 18px;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 900px) {
		.cyber-hero {
			grid-template-columns: 1fr;
		}

		.loader-panel {
			max-width: 360px;
		}
	}

	@keyframes hero-scan {
		from {
			transform: translateX(-80%);
		}

		to {
			transform: translateX(80%);
		}
	}

	@keyframes neon-flow {
		0%,
		100% {
			text-shadow:
				0 0 4px rgba(255, 255, 255, 0.95),
				0 0 14px rgba(119, 255, 230, 0.8),
				0 0 30px rgba(255, 91, 123, 0.48),
				0 0 54px rgba(255, 204, 92, 0.3);
		}

		50% {
			text-shadow:
				0 0 6px rgba(255, 255, 255, 1),
				0 0 20px rgba(255, 204, 92, 0.82),
				0 0 36px rgba(119, 255, 230, 0.58),
				0 0 68px rgba(255, 91, 123, 0.48);
		}
	}
</style>

<script>
	const rippleTargets = document.querySelectorAll<HTMLElement>('[data-ripple-text]');

	for (const target of rippleTargets) {
		target.addEventListener('pointerdown', (event) => {
			const rect = target.getBoundingClientRect();
			const ring = document.createElement('span');
			ring.className = 'text-ripple';
			ring.style.left = `${event.clientX - rect.left}px`;
			ring.style.top = `${event.clientY - rect.top}px`;
			target.appendChild(ring);
			ring.addEventListener('animationend', () => ring.remove(), { once: true });
		});
	}

	const particleButtons = document.querySelectorAll<HTMLElement>('.particle-button');

	for (const button of particleButtons) {
		button.addEventListener('pointerdown', (event) => {
			button.classList.add('is-pressed');
			const rect = button.getBoundingClientRect();
			const originX = event.clientX - rect.left;
			const originY = event.clientY - rect.top;

			for (let index = 0; index < 16; index += 1) {
				const particle = document.createElement('span');
				const angle = (Math.PI * 2 * index) / 16;
				const distance = 28 + Math.random() * 34;
				particle.className = 'button-particle';
				particle.style.left = `${originX}px`;
				particle.style.top = `${originY}px`;
				particle.style.setProperty('--x', `${Math.cos(angle) * distance}px`);
				particle.style.setProperty('--y', `${Math.sin(angle) * distance}px`);
				button.appendChild(particle);
				particle.addEventListener('animationend', () => particle.remove(), { once: true });
			}
		});

		button.addEventListener('pointerup', () => button.classList.remove('is-pressed'));
		button.addEventListener('pointerleave', () => button.classList.remove('is-pressed'));
	}

	const canvas = document.querySelector<HTMLCanvasElement>('#polygon-loader');
	const context = canvas?.getContext('2d');

	if (canvas && context) {
		const resizeCanvas = () => {
			const size = canvas.clientWidth || 300;
			const scale = window.devicePixelRatio || 1;
			canvas.width = size * scale;
			canvas.height = size * scale;
			context.setTransform(scale, 0, 0, scale, 0, 0);
		};

		resizeCanvas();
		window.addEventListener('resize', resizeCanvas);

		const draw = (time: number) => {
			const size = canvas.clientWidth || 300;
			const center = size / 2;
			const progress = (Math.sin(time / 900) + 1) / 2;
			context.clearRect(0, 0, size, size);

			context.save();
			context.translate(center, center);
			context.rotate(time / 1100);

			for (let layer = 0; layer < 3; layer += 1) {
				const sides = 5 + layer;
				const radius = 54 + layer * 34 + progress * 12;
				context.beginPath();
				for (let index = 0; index <= sides; index += 1) {
					const angle = (Math.PI * 2 * index) / sides;
					const x = Math.cos(angle) * radius;
					const y = Math.sin(angle) * radius;
					if (index === 0) context.moveTo(x, y);
					else context.lineTo(x, y);
				}
				context.strokeStyle = ['#77ffe6', '#ffc857', '#ff5b7b'][layer];
				context.lineWidth = 3;
				context.shadowBlur = 18;
				context.shadowColor = context.strokeStyle;
				context.stroke();
			}

			context.restore();

			context.beginPath();
			context.arc(center, center, 118, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * progress);
			context.strokeStyle = '#fffdf7';
			context.lineWidth = 8;
			context.lineCap = 'round';
			context.shadowBlur = 18;
			context.shadowColor = '#77ffe6';
			context.stroke();

			context.shadowBlur = 0;
			context.fillStyle = '#fffdf7';
			context.font = '700 24px system-ui, sans-serif';
			context.textAlign = 'center';
			context.textBaseline = 'middle';
			context.fillText(`${Math.round(progress * 100)}%`, center, center);

			requestAnimationFrame(draw);
		};

		requestAnimationFrame(draw);
	}
</script>
