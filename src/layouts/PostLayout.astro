---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, sitePath, slugifyTag } from '../utils/posts';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<article class="prose">
		<header>
			<p class="eyebrow">文章</p>
			<h1 class="page-title">{post.data.title}</h1>
			<div class="post-meta">
				<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
				{
					post.data.updatedDate && (
						<span>更新于 {formatDate(post.data.updatedDate)}</span>
					)
				}
			</div>
			{
				post.data.tags.length > 0 && (
					<ul class="tag-list" aria-label="文章标签">
						{post.data.tags.map((tag) => (
							<li>
								<a class="tag" href={sitePath(`/tags/${slugifyTag(tag)}/`)}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>
		<slot />
	</article>
</BaseLayout>

<style>
	header {
		display: grid;
		gap: 18px;
		margin-bottom: 40px;
	}

	.page-title {
		font-size: clamp(2rem, 6vw, 4rem);
	}
</style>
