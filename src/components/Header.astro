---
import { SITE_TITLE } from '../consts';
import { sitePath } from '../utils/posts';

const navItems = [
	{ href: '/', label: '首页' },
	{ href: '/blog/', label: '文章' },
	{ href: '/tags/', label: '标签' },
	{ href: '/about/', label: '关于' },
];
---

<header class="site-header">
	<a class="brand" href={sitePath('/')}>{SITE_TITLE}</a>
	<nav aria-label="主导航">
		{
			navItems.map((item) => (
				<a href={sitePath(item.href)} aria-current={Astro.url.pathname === sitePath(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(100% - 32px, 1080px);
		margin: 0 auto;
		padding: 22px 0;
		border-bottom: 1px solid var(--color-border);
	}

	.brand {
		color: var(--color-text);
		font-size: 1.12rem;
		font-weight: 800;
		text-decoration: none;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	nav a {
		padding: 6px 10px;
		border-radius: 999px;
		color: var(--color-muted);
		font-size: 0.95rem;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		background: rgba(32, 106, 93, 0.1);
		color: var(--color-primary-strong);
	}

	@media (max-width: 620px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			width: min(100% - 24px, 1080px);
		}

		nav {
			justify-content: flex-start;
		}
	}
</style>
